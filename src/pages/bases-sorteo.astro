---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Migas from "../components/Migas.astro";
import { Camera, Gift, ScrollText } from "@lucide/astro";
import { SEMANA_INICIO_SORTEO } from "../lib/sorteoConfig";
import { etiquetaSemana } from "../lib/historial";
import { NEGOCIO, breadcrumbJsonLd } from "../lib/seo";

export const prerender = true;

// Bases del sorteo. Describen el sorteo tal y como está implementado en
// src/lib/sorteo.ts (una participación por persona, crypto.randomInt,
// anulación con motivo). Si cambia la mecánica, hay que actualizar esto.
const inicio = etiquetaSemana(SEMANA_INICIO_SORTEO);
const ACTUALIZADO = "7 de octubre de 2026";

const apartados: { titulo: string; parrafos: string[] }[] = [
  {
    titulo: "Quién organiza",
    parrafos: [
      `${NEGOCIO.nombre}, disco pub situado en la Plaza Mayor, 6, de El Bonillo (Albacete), organiza un sorteo entre quienes suben fotos a la galería de esta web las semanas en que hay premio.`,
    ],
  },
  {
    titulo: "Qué semanas hay sorteo",
    parrafos: [
      "Solo hay sorteo las semanas en que el premio aparece publicado en esta web, en la sección «Premio semanal». Normalmente coincide con las semanas con DJ, aunque no todas.",
      "Si una semana no aparece ningún premio publicado, esa semana no hay sorteo. Si tienes dudas, también puedes preguntar al personal del Lío.",
    ],
  },
  {
    titulo: "Quién puede participar",
    parrafos: [
      "Pueden participar las personas mayores de 18 años. La organización puede pedir que se acredite la edad al entregar el premio.",
    ],
  },
  {
    titulo: "Cómo se participa",
    parrafos: [
      "Subiendo al menos una foto del fin de semana a la galería de la web, siguiendo las condiciones de subida: sin registro, con tu foto, un nombre y tu usuario de Instagram, y hasta 3 fotos por dispositivo. Cada foto se modera antes de publicarse.",
      "Hay una participación por persona y semana, aunque subas varias fotos. Para saber si varias fotos son de la misma persona tenemos en cuenta el dispositivo desde el que se suben y el Instagram indicado.",
      "La semana de concurso va de jueves a miércoles (hora peninsular). Entran en el sorteo las fotos aprobadas de esa semana.",
    ],
  },
  {
    titulo: "Cuándo y cómo se sortea",
    parrafos: [
      "Al cerrar la semana de concurso, desde el panel de administración del Lío, con un sistema aleatorio: la web elige a la persona ganadora y nadie la elige a mano.",
      "Cada sorteo queda registrado con la fecha, el número de participantes y una huella digital de la lista de participaciones, para que no se pueda cambiar después.",
      `Las fotos más votadas siguen saliendo en el podio de «Las más votadas», pero los votos no influyen en el sorteo. Este sistema se aplica desde la semana del ${inicio}; las semanas anteriores se resolvieron por votos y se mantienen tal cual.`,
    ],
  },
  {
    titulo: "Cómo contactamos con quien gana",
    parrafos: [
      "Por mensaje privado al Instagram que dejó al subir la foto, así que es importante escribir bien tu usuario. El resultado se publica también en la web.",
      "Antes de entregar el premio comprobamos, a través de esa misma cuenta de Instagram, que la foto es de quien la subió.",
    ],
  },
  {
    titulo: "Plazos",
    parrafos: [
      "Quien gane tiene 7 días desde que le contactamos para responder, y 7 días más para canjear el premio en el Lío.",
      "Si no responde o no lo canjea a tiempo, el premio se considera desierto o se repite el sorteo de esa semana, a criterio de la organización. Si se repite, la persona del sorteo anterior ya no entra.",
    ],
  },
  {
    titulo: "Condiciones del premio",
    parrafos: [
      "El premio es el que aparece publicado en la web esa semana. Se canjea en el Lío Music Pub, en su horario de apertura.",
      "Es personal e intransferible y no se puede cambiar por dinero. Si el premio incluye bebidas alcohólicas, solo se entrega a mayores de 18 años.",
    ],
  },
  {
    titulo: "Exclusiones",
    parrafos: [
      "Quedan fuera del sorteo las fotos rechazadas en la moderación y las que incumplan las normas de subida de la web: fotos con contenido ofensivo, fotos de otras personas sin su consentimiento o fotos que no sean de quien las sube.",
      "Si la persona ganadora no cumple estas bases, el sorteo de esa semana se anula y se repite.",
    ],
  },
];

const datos = [
  { nombre: "Responsable", texto: `${NEGOCIO.nombre} (Plaza Mayor, 6, 02610 El Bonillo, Albacete).` },
  { nombre: "Datos", texto: "La foto, el nombre y el usuario de Instagram que nos facilitas al participar." },
  {
    nombre: "Finalidad",
    texto: "Gestionar el concurso y el sorteo, publicar las fotos en la galería y contactar con quien gane.",
  },
  { nombre: "Base legal", texto: "Tu consentimiento, que das al subir la foto." },
  {
    nombre: "Conservación",
    texto: "Mientras la foto esté publicada en la galería o hasta que pidas que la retiremos.",
  },
  {
    nombre: "Tus derechos",
    texto: `Puedes acceder a tus datos, rectificarlos, suprimirlos o pedir que retiremos tu foto escribiéndonos por mensaje privado a ${NEGOCIO.instagramHandle} en Instagram.`,
  },
];

const jsonLd = breadcrumbJsonLd([
  { nombre: "Inicio", ruta: "/" },
  { nombre: "Bases del sorteo", ruta: "/bases-sorteo/" },
]);
---

<Base
  title="Bases del sorteo · Lío Music Pub, El Bonillo"
  description="Cómo funciona el sorteo del Lío Music Pub de El Bonillo las semanas con premio: quién participa, cuándo se sortea, plazos, condiciones del premio y protección de datos."
  jsonLd={jsonLd}
>
  <Nav />
  <main id="contenido" class="px-5 pt-24 pb-20 md:px-10 md:pt-32">
    <div class="mx-auto max-w-[760px]">
      <Migas migas={[{ nombre: "Inicio", ruta: "/" }, { nombre: "Bases del sorteo" }]} />

      <header class="mb-10">
        <p class="section-label"><ScrollText size={14} stroke-width={2} />· Concurso</p>
        <h1 class="font-display text-[clamp(2.6rem,7vw,4.8rem)] leading-[0.95] tracking-[0.01em] text-text">
          Bases del sorteo
          <span class="mt-3 block font-mono text-[clamp(0.7rem,1.5vw,0.85rem)] font-normal tracking-[0.18em] text-accent uppercase">
            Lío Music Pub · El Bonillo
          </span>
        </h1>
        <p class="mt-6 text-lg font-light text-muted">
          Las semanas con premio, entras en el sorteo solo por subir tu foto del finde. Aquí te
          contamos cómo funciona, sin letra pequeña.
        </p>
        <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted">
          Actualizadas el {ACTUALIZADO}
        </p>
      </header>

      <ol class="flex flex-col gap-10">
        {
          apartados.map((a, i) => (
            <li>
              <h2 class="mb-3 flex items-baseline gap-3 font-display text-[clamp(1.6rem,3.4vw,2.2rem)] leading-none text-text">
                <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, "0")}</span>
                {a.titulo}
              </h2>
              <div class="flex flex-col gap-3 text-base leading-relaxed font-light text-text/80">
                {a.parrafos.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </li>
          ))
        }

        <li>
          <h2 class="mb-4 flex items-baseline gap-3 font-display text-[clamp(1.6rem,3.4vw,2.2rem)] leading-none text-text">
            <span class="font-mono text-sm text-accent">{String(apartados.length + 1).padStart(2, "0")}</span>
            Protección de datos
          </h2>
          <!-- Completar con la razón social y el NIF del titular del Lío cuando el cliente los facilite -->
          <dl class="divide-y divide-border border border-border bg-bg2">
            {
              datos.map((d) => (
                <div class="grid gap-1 px-5 py-4 sm:grid-cols-[150px_1fr] sm:gap-6">
                  <dt class="font-mono text-[0.62rem] uppercase tracking-[0.18em] text-accent sm:pt-1">{d.nombre}</dt>
                  <dd class="text-base leading-relaxed font-light text-text/80">{d.texto}</dd>
                </div>
              ))
            }
          </dl>
        </li>

        <li>
          <h2 class="mb-3 flex items-baseline gap-3 font-display text-[clamp(1.6rem,3.4vw,2.2rem)] leading-none text-text">
            <span class="font-mono text-sm text-accent">{String(apartados.length + 2).padStart(2, "0")}</span>
            Aceptación de las bases
          </h2>
          <p class="text-base leading-relaxed font-light text-text/80">
            Participar implica aceptar estas bases. La organización puede modificarlas avisando en
            esta misma web.
          </p>
        </li>
      </ol>

      <div class="mt-16 flex flex-wrap gap-3 border-t border-border pt-10">
        <a
          href="/#subir"
          class="inline-flex items-center gap-2 bg-accent px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-bg transition-transform hover:-translate-y-0.5"
        >
          <Camera size={15} stroke-width={2} />
          Sube tu foto
        </a>
        <a
          href="/#premio"
          class="inline-flex items-center gap-2 border border-border px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Gift size={15} stroke-width={2} />
          ¿Hay premio esta semana?
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
