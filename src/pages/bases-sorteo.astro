---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Migas from "../components/Migas.astro";
import { TriangleAlert, Camera, Dices, ScrollText } from "@lucide/astro";
import { SEMANA_INICIO_SORTEO } from "../lib/sorteoConfig";
import { etiquetaSemana } from "../lib/historial";
import { NEGOCIO, breadcrumbJsonLd } from "../lib/seo";

export const prerender = true;

// Bases redactadas a partir de cómo funciona el sorteo implementado
// (src/lib/sorteo.ts). Lo marcado como "pendiente" lo tienen que revisar el
// cliente y su asesor antes de darlo por definitivo.
const inicio = etiquetaSemana(SEMANA_INICIO_SORTEO);

const apartados = [
  {
    titulo: "Quién organiza",
    parrafos: [
      `${NEGOCIO.nombre}, disco pub en la Plaza Mayor, 6, de El Bonillo (Albacete), organiza un sorteo semanal entre quienes suben fotos a la galería de esta web.`,
    ],
  },
  {
    titulo: "Quién participa",
    parrafos: [
      "Participan las personas que suben una foto del finde a la galería de liopub.com y cuya foto es aprobada en la moderación. Las fotos deben estar hechas en el Lío o en sus alrededores y no pueden ser ofensivas ni tomadas sin consentimiento.",
      "Cada persona entra en el sorteo una sola vez por semana, aunque haya subido varias fotos (se pueden subir hasta 3 por dispositivo). Para saber si varias fotos son de la misma persona tenemos en cuenta el dispositivo desde el que se suben y el Instagram indicado.",
    ],
    pendiente: "Edad mínima para participar (al ser un pub, probablemente mayores de 18 años).",
  },
  {
    titulo: "Semana de concurso y cuándo se sortea",
    parrafos: [
      "Cada semana de concurso va de jueves a miércoles (hora peninsular). Entran en el sorteo las fotos aprobadas de esa semana.",
      "El sorteo se hace cuando la semana termina, a partir del jueves siguiente, desde el panel de administración. La persona ganadora la elige el servidor con un generador de números aleatorios criptográfico: nadie la elige a mano.",
      "Cada sorteo queda registrado con la fecha, el número de participantes y una huella digital (SHA-256) de la lista de participaciones, de forma que la lista no se puede cambiar después sin que se note.",
    ],
  },
  {
    titulo: "Cómo nos ponemos en contacto",
    parrafos: [
      "La persona ganadora se anuncia en la web (sección de premio de la semana) y le escribimos por mensaje directo al Instagram que indicó al subir la foto. Por eso es importante poner bien tu usuario de Instagram.",
      "Antes de entregar el premio verificamos que la foto es de quien la subió, a través de esa misma cuenta de Instagram.",
    ],
  },
  {
    titulo: "Plazo para reclamar el premio",
    parrafos: [
      "Quien gane debe responder y recoger el premio dentro del plazo indicado. Si no responde en plazo, si no se puede verificar la autoría o si no cumple estas bases, el sorteo se anula (quedando registrado el motivo) y se repite. En la repetición no vuelve a entrar la persona del sorteo anulado.",
    ],
    pendiente: "Plazo exacto para responder y para canjear el premio (por ejemplo, 7 días).",
  },
  {
    titulo: "El premio",
    parrafos: [
      "El premio es el que se anuncia en la web como «Premio de la semana» y se canjea en el Lío Music Pub dentro de su fecha de validez. El premio no se puede canjear por dinero.",
    ],
    pendiente: "Condiciones de canje (días, horario, si es transferible).",
  },
  {
    titulo: "Los votos y el podio",
    parrafos: [
      "Los votos de la galería sirven para el podio de «Las más votadas», que es solo por diversión: estar en el podio no da premio ni más opciones en el sorteo.",
      `Este sistema se aplica desde la semana del ${inicio}. Las semanas anteriores se resolvieron por votos y se mantienen tal cual.`,
    ],
  },
  {
    titulo: "Datos personales",
    parrafos: [
      "Usamos el nombre y la foto para mostrarlos en la galería, y el Instagram solo para contactar y verificar a quien gane. Si quieres que retiremos tu foto, escríbenos por Instagram.",
    ],
    pendiente: "Texto de protección de datos (responsable, finalidad, derechos), a revisar por el asesor.",
  },
];

const jsonLd = breadcrumbJsonLd([
  { nombre: "Inicio", ruta: "/" },
  { nombre: "Bases del sorteo", ruta: "/bases-sorteo/" },
]);
---

<Base
  title="Bases del sorteo semanal · Lío Music Pub, El Bonillo"
  description="Cómo funciona el sorteo semanal del Lío Music Pub de El Bonillo: quién participa, cuándo se sortea, cómo contactamos con quien gana y condiciones del premio."
  jsonLd={jsonLd}
>
  <Nav />
  <main id="contenido" class="px-5 pt-24 pb-20 md:px-10 md:pt-32">
    <div class="mx-auto max-w-[760px]">
      <Migas migas={[{ nombre: "Inicio", ruta: "/" }, { nombre: "Bases del sorteo" }]} />

      <header class="mb-10">
        <p class="section-label"><ScrollText size={14} stroke-width={2} />· Concurso</p>
        <h1 class="font-display text-[clamp(2.6rem,7vw,4.8rem)] leading-[0.95] tracking-[0.01em] text-text">
          Bases del sorteo semanal
          <span class="mt-3 block font-mono text-[clamp(0.7rem,1.5vw,0.85rem)] font-normal tracking-[0.18em] text-accent uppercase">
            Lío Music Pub · El Bonillo
          </span>
        </h1>
      </header>

      <!-- TODO: revisar por el cliente/asesor. Bases provisionales: no son un texto legal definitivo. -->
      <p class="mb-12 flex items-start gap-3 border border-accent/40 bg-accent/10 px-5 py-4 text-sm text-text">
        <TriangleAlert size={18} stroke-width={1.75} class="mt-0.5 shrink-0 text-accent" />
        <span>
          <strong>Bases provisionales.</strong> Describen cómo funciona el sorteo, pero algunos
          puntos están pendientes de revisión y pueden cambiar.
        </span>
      </p>

      <ol class="flex flex-col gap-10">
        {
          apartados.map((a, i) => (
            <li>
              <h2 class="mb-3 flex items-baseline gap-3 font-display text-[clamp(1.6rem,3.4vw,2.2rem)] leading-none text-text">
                <span class="font-mono text-sm text-accent">{String(i + 1).padStart(2, "0")}</span>
                {a.titulo}
              </h2>
              <div class="flex flex-col gap-3 text-base leading-relaxed font-light text-text/80">
                {a.parrafos.map((p) => (
                  <p>{p}</p>
                ))}
                {a.pendiente && (
                  <>
                    <Fragment set:html={`<!-- TODO: revisar por el cliente/asesor: ${a.pendiente} -->`} />
                    <p class="border-l-2 border-accent bg-bg2 px-4 py-2.5 font-mono text-[0.72rem] tracking-wide text-muted">
                      Pendiente de revisión: {a.pendiente}
                    </p>
                  </>
                )}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mt-16 flex flex-wrap gap-3 border-t border-border pt-10">
        <a
          href="/#subir"
          class="inline-flex items-center gap-2 bg-accent px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-bg transition-transform hover:-translate-y-0.5"
        >
          <Camera size={15} stroke-width={2} />
          Sube tu foto
        </a>
        <a
          href="/#premio"
          class="inline-flex items-center gap-2 border border-border px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-text transition-colors hover:border-accent hover:text-accent"
        >
          <Dices size={15} stroke-width={2} />
          Premio de la semana
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
