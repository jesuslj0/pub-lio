      }
      .foto-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
        flex: 1;
        min-width: 0;
      }
      .foto-actions {
        display: flex;
        gap: 8px;
      }
      /* Estado ganadora */
      .winner-flag {
        display: none;
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 700;
      }
      .winner-row.is-winner {
        border-color: var(--accent);
      }
      .winner-row.is-winner .winner-flag {
        display: inline;
      }
      /* Historial carteles/premios */
      .active-flag {
        display: none;
        color: var(--accent);
