      }
      .btn-logout {
        padding: 6px 12px;
        font-size: 0.7rem;
        white-space: nowrap;
        align-self: flex-start;
      }
      .cartel-form {
        display: flex;
        flex-direction: column;
        gap: 16px;
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 24px;
      }
      .cartel-form .btn-primary {
        align-self: flex-start;
      }
      .cartel-preview {
        max-width: 240px;
        border: 1px solid var(--border);
        object-fit: cover;
      }
      /* Etiqueta + control como hermanos (nunca anidados: en iOS un control
         dentro de <label> se activa dos veces y el selector de fecha se cierra). */
      .campo {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      label {
        font-size: 0.8rem;
        color: var(--muted);
      }
      label.checkbox {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 10px;
        color: var(--text);
        min-height: 44px;
      }
      input[type="text"],
      input[type="url"],
      textarea {
        background: var(--bg);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 10px 12px;
        /* 16px absolutos: por debajo, iOS hace zoom al enfocar. */
        font-size: 16px;
        width: 100%;
        box-sizing: border-box;
      }
      input[type="text"] {
        min-height: 44px;
      }
      input[type="file"] {
        max-width: 100%;
        font-size: 16px;
      }
      .cartel-form .btn {
        min-height: 44px;
      }
      textarea {
        font-family: inherit;
        resize: vertical;
      }
      .row {
        display: flex;
        gap: 16px;
      }
      .row .campo {
        flex: 1;
        min-width: 0;
      }
      .msg {
        font-size: 0.85rem;
        min-height: 1.2em;
      }
      .msg.ok {
        color: var(--green);
      }
      .msg.err {
        color: var(--red);
      }
      /* Aviso de carteles → /eventos */
      .aviso-eventos {
        margin: 10px 0 4px;
        padding: 10px 14px;
        border-left: 2px solid var(--accent);
        background: var(--surface);
        color: var(--text);
        font-size: 0.8rem;
      }
      .aviso-eventos a {
        color: var(--accent);
      }
      /* Sorteo */
      .sorteo-panel {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
        padding: 20px;
        background: var(--surface);
        border: 1px solid var(--border);
      }
      .sorteo-aviso {
        padding: 10px 14px;
        border-left: 2px solid var(--accent);
        background: var(--bg);
        color: var(--text);
        font-size: 0.82rem;
      }
      .sorteo-cuenta {
        display: flex;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 6px;
      }
      .sorteo-cuenta strong {
        font-size: 2rem;
        line-height: 1;
        color: var(--accent);
      }
      .btn-sortear {
        font-size: 0.95rem;
        padding: 12px 22px;
      }
      .bombo {
        display: flex;
        align-items: center;
        gap: 14px;
        width: 100%;
        padding: 14px;
        border: 1px dashed var(--accent);
        background: var(--bg);
      }
      .bombo[hidden] {
        display: none;
      }
      .bombo-foto {
        width: 64px;
        height: 64px;
        object-fit: cover;
      }
      .bombo-nombre {
        font-size: 1.4rem;
        font-weight: 700;
      }
      .bombo.girando .bombo-foto {
        filter: blur(1.5px);
      }
      .bombo.ganador {
        border-style: solid;
        box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 45%, transparent);
      }
      .bombo.ganador .bombo-nombre {
        color: var(--accent);
      }
      .sorteo-resultado {
        display: flex;
        gap: 18px;
        padding: 18px;
        background: var(--surface);
        border: 1px solid var(--accent);
      }
      .sorteo-foto {
        width: 140px;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        flex-shrink: 0;
      }
      .sorteo-datos {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 6px;
        min-width: 0;
      }
      .sorteo-nombre {
        font-size: 1.5rem;
      }
      .sorteo-ig {
        color: var(--accent);
        font-size: 0.9rem;
      }
      .sorteo-hash {
        font-family: ui-monospace, monospace;
        word-break: break-all;
      }
      .sorteo-anular {
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: 100%;
        margin-top: 6px;
      }
      .sorteo-anular[hidden] {
        display: none;
      }
      .sorteo-anular label {
        font-size: 0.8rem;
      }
      .sorteo-anular textarea {
        background: var(--bg);
        color: var(--text);
        border: 1px solid var(--border);
        padding: 8px;
        font: inherit;
        font-size: 16px;
      }
      .sorteo-anulados,
      .emergencia {
        margin-top: 14px;
        font-size: 0.85rem;
      }
      .sorteo-anulados summary,
      .emergencia summary {
        cursor: pointer;
        color: var(--muted);
      }
      .sorteo-anulados ul {
        margin: 8px 0 0 18px;
      }
      .emergencia[open] summary {
        margin-bottom: 8px;
        color: var(--red);
      }
      @media (max-width: 680px) {
        .sorteo-resultado {
          flex-direction: column;
        }
      }
      /* Modal de confirmación */
      .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(4, 4, 10, 0.72);
        backdrop-filter: blur(3px);
      }
      .modal-overlay[hidden] {
        display: none;
      }
      .modal-box {
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        background: var(--surface);
        border: 1px solid var(--border);
        padding: 24px;
      }
      .modal-box h3 {
        font-size: 1.05rem;
      }
      .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 8px;
      }
      @media (max-width: 680px) {
        body {
          padding: 32px 20px;
        }
        main {
          gap: 36px;
        }
        .head {
          align-items: flex-start;
        }
        .foto-row {
          flex-wrap: wrap;
          max-width: 100%;
          overflow: hidden;
        }
        .foto-info {
          min-width: calc(100% - 80px);
          overflow: hidden;
        }
        .foto-info strong,
        .foto-info span {
          display: block;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        .foto-actions {
          width: 100%;
          flex-wrap: wrap;
        }
        .foto-actions .btn {
          flex: 1;
          min-width: 80px;
          text-align: center;
        }
        .row {
          flex-direction: column;
          gap: 12px;
        }
        .modal-box {
          padding: 24px 20px;
        }
        .modal-actions {
          flex-direction: column-reverse;
        }
        .modal-actions .btn {
          width: 100%;
          text-align: center;
        }
        h1 {
          font-size: 1.15rem;
        }
        .hist-grid {
          grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        }
      }
    </style>
  </body>
</html>
