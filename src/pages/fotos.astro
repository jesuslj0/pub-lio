---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HistorialFotos from "../components/HistorialFotos.tsx";
import { ArrowLeft, Camera, Crown, Heart, History, Images, CalendarDays } from "@lucide/astro";
import { getCurrentWeek } from "../lib/supabase";
import { breadcrumbJsonLd } from "../lib/seo";
import {
  cargarResumen,
  cargarTanda,
  etiquetaSemana,
  type FiltroHistorial,
  type FotoHistorial,
  type ResumenHistorial,
} from "../lib/historial";

export const prerender = false;

// Filtros por query string (enlaces compartibles): ?semana=2026-W37 · ?ganadoras=1
const params = Astro.url.searchParams;
const semanaParam = params.get("semana");
const filtro: FiltroHistorial = {
  semana: semanaParam && /^\d{4}-W\d{2}$/.test(semanaParam) ? semanaParam : null,
  soloGanadoras: params.get("ganadoras") === "1",
};
const semanaActual = getCurrentWeek();

let fotos: FotoHistorial[] = [];
let resumen: ResumenHistorial = { totalFotos: 0, totalVotos: 0, semanas: [] };
let fallo = false;
try {
  [fotos, resumen] = await Promise.all([cargarTanda(filtro, 0), cargarResumen()]);
} catch (err) {
  console.error("[fotos]", err);
  fallo = true;
}

const fmt = new Intl.NumberFormat("es-ES");
const stats = [
  { valor: resumen.totalFotos, etiqueta: "fotos", icono: Images },
  { valor: resumen.totalVotos, etiqueta: "likes", icono: Heart },
  { valor: resumen.semanas.length, etiqueta: "findes", icono: CalendarDays },
];

const esTodas = !filtro.semana && !filtro.soloGanadoras;
const chip =
  "inline-flex shrink-0 items-center gap-1.5 border px-3.5 py-2 font-mono text-[0.65rem] uppercase tracking-[0.14em] whitespace-nowrap transition-colors";
const chipOn = "border-accent bg-accent text-bg";
const chipOff = "border-border bg-bg2 text-muted hover:border-accent/60 hover:text-text";
---

<Base
  title="Salón de la fama · Fotos del Lío Music Pub, El Bonillo"
  description="Todas las fotos del público en el Lío Music Pub de El Bonillo (Albacete): el ranking histórico de la más votada a la menos y las ganadoras de cada semana."
  jsonLd={breadcrumbJsonLd([
    { nombre: "Inicio", ruta: "/" },
    { nombre: "Salón de la fama", ruta: "/fotos/" },
  ])}
>
  <Nav />
  <main id="contenido" class="px-5 pt-24 pb-16 md:px-10 md:pt-32">
    <div class="mx-auto max-w-[1280px]">
      <a
        href="/#fotos"
        class="mb-8 inline-flex items-center gap-2 font-mono text-[0.65rem] uppercase tracking-[0.2em] text-muted transition-colors hover:text-accent"
      >
        <ArrowLeft size={14} stroke-width={2} />
        Volver al inicio
      </a>

      <!-- Cabecera -->
      <header class="mb-10 flex flex-col gap-8 md:mb-12 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="section-label"><History size={14} stroke-width={2} />· Historial</p>
          <h1 class="font-display text-[clamp(3rem,9vw,7rem)] leading-[0.9] tracking-[0.02em] text-text">
            Salón <br />de la <span class="text-accent">fama</span>
          </h1>
          <p class="mt-4 max-w-md text-base font-medium text-muted md:text-lg">
            Todas las fotos del Lío, de la más votada a la menos.
          </p>
        </div>

        {
          !fallo && (
            <dl class="grid grid-cols-3 border border-border bg-bg2 md:min-w-[380px]">
              {stats.map(({ valor, etiqueta, icono: Icono }, i) => (
                <div class:list={["flex flex-col gap-1 px-4 py-4 md:px-5", i > 0 && "border-l border-border"]}>
                  <dt class="inline-flex items-center gap-1.5 font-mono text-[0.58rem] uppercase tracking-[0.2em] text-muted">
                    <Icono size={11} stroke-width={2} />
                    {etiqueta}
                  </dt>
                  <dd class="font-display text-3xl leading-none text-text md:text-4xl">
                    {fmt.format(valor)}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </header>

      <!-- Filtros: carrusel horizontal en móvil -->
      <nav
        aria-label="Filtrar fotos"
        class="lio-chips -mx-5 mb-6 flex gap-2 overflow-x-auto px-5 pb-1 md:mx-0 md:flex-wrap md:px-0"
      >
        <a href="/fotos" class:list={[chip, esTodas ? chipOn : chipOff]} aria-current={esTodas ? "page" : undefined}>
          Todas
        </a>
        <a
          href="/fotos?ganadoras=1"
          class:list={[chip, filtro.soloGanadoras ? chipOn : chipOff]}
          aria-current={filtro.soloGanadoras ? "page" : undefined}
        >
          <Crown size={12} stroke-width={2} />
          Ganadoras
        </a>
        <span class="mx-1 w-px shrink-0 self-stretch bg-border" aria-hidden="true"></span>
        {
          resumen.semanas.map((s) => (
            <a
              href={`/fotos?semana=${s}`}
              class:list={[chip, filtro.semana === s ? chipOn : chipOff]}
              aria-current={filtro.semana === s ? "page" : undefined}
            >
              {etiquetaSemana(s)}
              {s === semanaActual && (
                <span class:list={["size-1.5 rounded-full", filtro.semana === s ? "bg-bg" : "bg-accent"]} title="En juego" />
              )}
            </a>
          ))
        }
      </nav>

      {
        filtro.semana === semanaActual && (
          <p class="mb-6 inline-flex flex-wrap items-center gap-x-2 gap-y-1 border-l-2 border-accent bg-bg2 px-4 py-3 font-mono text-[0.68rem] tracking-wide text-muted">
            Esta semana sigue en juego: el ranking puede cambiar.
            <a href="/#fotos" class="text-accent underline-offset-4 hover:underline">Vota en la home →</a>
          </p>
        )
      }

      {
        fallo ? (
          <p class="border border-border bg-bg2 px-6 py-16 text-center font-mono text-sm text-muted">
            No se pudo cargar el historial. Prueba a recargar la página.
          </p>
        ) : (
          <HistorialFotos client:load fotosIniciales={fotos} filtro={filtro} semanaActual={semanaActual} />
        )
      }

      <!-- CTA final -->
      <section class="mt-16 flex flex-col items-start gap-6 border-t border-border pt-12 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="font-display text-[clamp(2.2rem,5vw,4rem)] leading-[0.92] tracking-[0.02em] text-text">
            ¿Quieres salir<br />en el ranking?
          </h2>
          <p class="mt-4 max-w-md text-sm font-light text-muted">
            Las semanas con premio, entras en el sorteo solo por subir tu foto del
            finde. ¡Y si es de las más votadas, sale en el podio!
            <a href="/bases-sorteo/" class="text-accent underline-offset-4 hover:underline">Bases del sorteo</a>
          </p>
        </div>
        <a
          href="/#subir"
          class="inline-flex items-center gap-2 border border-accent px-6 py-3.5 font-mono text-[0.72rem] font-bold uppercase tracking-[0.12em] text-accent transition-[background-color,color,box-shadow] hover:bg-accent hover:text-bg hover:shadow-[0_0_18px_color-mix(in_srgb,var(--color-accent)_40%,transparent)]"
        >
          <Camera size={16} stroke-width={2} />
          Sube tu foto del finde
        </a>
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .lio-chips {
    scrollbar-width: none;
  }
  .lio-chips::-webkit-scrollbar {
    display: none;
  }
</style>
