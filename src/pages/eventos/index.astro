---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Migas from "../../components/Migas.astro";
import EventoCard from "../../components/EventoCard.astro";
import { CalendarDays, History, Sparkles } from "@lucide/astro";
import { siInstagram } from "simple-icons";
import {
  cargarEventos,
  imagenCloudinary,
  rangoCorto,
  tienePagina,
  type ListadoEventos,
} from "../../lib/eventos";
import { NEGOCIO, breadcrumbJsonLd, urlCanonica } from "../../lib/seo";

export const prerender = false;

let listado: ListadoEventos = { proximos: [], pasados: [] };
let fallo = false;
try {
  listado = await cargarEventos();
} catch (err) {
  console.error("[eventos]", err);
  fallo = true;
}
const { proximos, pasados } = listado;
const ahora = Date.now();

// Lo que se sube en el admin aparece aquí en unos minutos.
if (!fallo) {
  Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=600");
}

const conPagina = [...proximos, ...pasados].filter(tienePagina);
const jsonLd = [
  breadcrumbJsonLd([
    { nombre: "Inicio", ruta: "/" },
    { nombre: "Eventos", ruta: "/eventos/" },
  ]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Eventos del Lío Music Pub en El Bonillo",
    itemListElement: conPagina.map((e, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: urlCanonica(e.ruta!),
      name: e.titulo,
    })),
  },
];
---

<Base
  title="Eventos en El Bonillo · Lío Music Pub"
  description="Próximos eventos y fiestas del Lío Music Pub en la Plaza Mayor de El Bonillo (Albacete): fechas, carteles y cómo llegar. Y la galería de los que ya pasaron."
  jsonLd={jsonLd}
>
  <Nav />
  <main id="contenido" class="px-5 pt-24 pb-20 md:px-10 md:pt-32">
    <div class="mx-auto max-w-[1180px]">
      <Migas migas={[{ nombre: "Inicio", ruta: "/" }, { nombre: "Eventos" }]} />

      <header class="mb-14 md:mb-20">
        <p class="section-label"><CalendarDays size={14} stroke-width={2} />· Agenda</p>
        <h1 class="font-display leading-[0.9] tracking-[0.02em] text-text">
          <span class="block text-[clamp(3.5rem,12vw,9rem)]">Eventos</span>
          <span class="mt-3 block font-mono text-[clamp(0.7rem,1.6vw,0.9rem)] font-normal tracking-[0.2em] text-accent uppercase">
            en el Lío Music Pub, El Bonillo
          </span>
        </h1>
        <p class="mt-6 max-w-xl text-base font-light text-muted md:text-lg">
          Los carteles del finde y las noches especiales del Lío, en la Plaza Mayor de
          El Bonillo (Albacete). Fechas, detalles y cómo llegar.
        </p>
      </header>

      {
        fallo && (
          <p class="mb-16 border border-border bg-bg2 px-6 py-12 text-center font-mono text-sm text-muted">
            No se pudieron cargar los eventos. Prueba a recargar la página.
          </p>
        )
      }

      <!-- PRÓXIMOS -->
      <section aria-labelledby="proximos-titulo" class="mb-20 md:mb-28">
        <div class="mb-8 flex items-end justify-between gap-4 border-b border-border pb-4">
          <h2 id="proximos-titulo" class="inline-flex items-center gap-3 font-display text-[clamp(2rem,5vw,3.4rem)] leading-none text-text">
            <Sparkles size={26} stroke-width={1.5} class="text-accent" />
            Próximos
          </h2>
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-muted">
            {proximos.length} {proximos.length === 1 ? "evento" : "eventos"}
          </span>
        </div>

        {
          proximos.length > 0 ? (
            <div class="grid gap-5 lg:grid-cols-2">
              {proximos.map((e) => (
                <EventoCard evento={e} ahora={ahora} />
              ))}
            </div>
          ) : (
            !fallo && (
              <div class="flex flex-col items-start gap-5 border border-dashed border-border bg-bg2/60 px-6 py-10 md:flex-row md:items-center md:justify-between md:px-10">
                <div>
                  <p class="font-display text-3xl leading-none text-text">Se está cociendo algo…</p>
                  <p class="mt-3 max-w-md text-sm font-light text-muted">
                    Ahora mismo no hay eventos anunciados. Los carteles del finde salen
                    primero en Instagram.
                  </p>
                </div>
                <a
                  href={NEGOCIO.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex shrink-0 items-center gap-2 border border-accent px-5 py-3 font-mono text-[0.7rem] font-bold uppercase tracking-[0.12em] text-accent transition-colors hover:bg-accent hover:text-bg"
                >
                  <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d={siInstagram.path} /></svg>
                  {NEGOCIO.instagramHandle}
                </a>
              </div>
            )
          )
        }
      </section>

      <!-- PASADOS -->
      <section aria-labelledby="pasados-titulo">
        <div class="mb-8 flex items-end justify-between gap-4 border-b border-border pb-4">
          <h2 id="pasados-titulo" class="inline-flex items-center gap-3 font-display text-[clamp(2rem,5vw,3.4rem)] leading-none text-text">
            <History size={26} stroke-width={1.5} class="text-accent" />
            Ya se lió
          </h2>
          <span class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-muted">Eventos pasados</span>
        </div>

        {
          pasados.length > 0 ? (
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
              {pasados.map((e) => (
                <li>
                  <a
                    href={e.ruta!}
                    class="pasado group relative block aspect-[9/16] overflow-hidden border border-border bg-surface"
                  >
                    {e.imagenFija ? (
                      <img
                        src={imagenCloudinary(e.imagenFija, 480)}
                        alt={`Cartel de ${e.titulo}`}
                        class="size-full object-cover grayscale-[35%] transition duration-500 group-hover:scale-[1.04] group-hover:grayscale-0"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="flex size-full items-center justify-center font-display text-3xl text-accent/15">LÍO</span>
                    )}
                    <span class="absolute inset-x-0 bottom-0 flex flex-col gap-1 bg-gradient-to-t from-bg via-bg/85 to-transparent px-3 pt-10 pb-3">
                      <span class="font-mono text-[0.58rem] uppercase tracking-[0.18em] text-accent">
                        {rangoCorto(e, true)}
                      </span>
                      <span class="font-display text-lg leading-tight text-text sm:text-xl">{e.titulo}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            !fallo && (
              <p class="border border-dashed border-border bg-bg2/60 px-6 py-10 text-sm font-light text-muted">
                Aquí irán quedando los carteles de cada finde que ya pasó.
              </p>
            )
          )
        }
      </section>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .pasado:hover,
  .pasado:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 22%, transparent);
  }
</style>
