---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Migas from "../../components/Migas.astro";
import { ArrowRight, Newspaper } from "@lucide/astro";
import { articulosVisibles, fechaIso, fechaLarga } from "../../lib/blog";
import { breadcrumbJsonLd } from "../../lib/seo";

export const prerender = true;

const articulos = await articulosVisibles();

const jsonLd = breadcrumbJsonLd([
  { nombre: "Inicio", ruta: "/" },
  { nombre: "Blog", ruta: "/blog/" },
]);
---

<Base
  title="Blog del Lío Music Pub · Planes de noche en El Bonillo"
  description="Planes, fiestas y noches en El Bonillo (Albacete) contados desde el Lío Music Pub, en la Plaza Mayor: los viernes de cañas, Nochevieja, las ferias y mucho más."
  jsonLd={jsonLd}
>
  <Nav />
  <main id="contenido" class="px-5 pt-24 pb-20 md:px-10 md:pt-32">
    <div class="mx-auto max-w-[920px]">
      <Migas migas={[{ nombre: "Inicio", ruta: "/" }, { nombre: "Blog" }]} />

      <header class="mb-12 md:mb-16">
        <p class="section-label"><Newspaper size={14} stroke-width={2} />· Blog</p>
        <h1 class="font-display leading-[0.9] tracking-[0.02em] text-text">
          <span class="block text-[clamp(3.2rem,10vw,7rem)]">Blog</span>
          <span class="mt-3 block font-mono text-[clamp(0.7rem,1.6vw,0.9rem)] font-normal tracking-[0.2em] text-accent uppercase">
            del Lío Music Pub, El Bonillo
          </span>
        </h1>
        <p class="mt-6 max-w-xl text-base font-light text-muted md:text-lg">
          Planes de noche en El Bonillo contados desde la Plaza Mayor.
        </p>
      </header>

      {
        articulos.length === 0 ? (
          <p class="border border-dashed border-border bg-bg2/60 px-6 py-10 text-sm font-light text-muted">
            Muy pronto, el primer artículo.
          </p>
        ) : (
          <ol class="flex flex-col gap-4">
            {articulos.map((a) => (
              <li>
                <article class="group relative border border-border bg-bg2 p-6 transition-colors hover:border-accent/50 md:p-8">
                  <p class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted">
                    <time datetime={fechaIso(a.data.pubDate)}>{fechaLarga(a.data.pubDate)}</time>
                    {a.data.draft && <span class="bg-accent px-2 py-0.5 font-bold text-bg">Borrador</span>}
                  </p>
                  <h2 class="font-display text-[clamp(1.6rem,3.6vw,2.4rem)] leading-[1] text-text">
                    <a href={`/blog/${a.id}/`} class="after:absolute after:inset-0">
                      {a.data.title}
                    </a>
                  </h2>
                  <p class="mt-3 max-w-2xl text-sm font-light text-muted md:text-base">{a.data.description}</p>
                  <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-text/70 transition-colors group-hover:text-accent">
                    Leer <ArrowRight size={13} stroke-width={2} />
                  </span>
                </article>
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </main>
  <Footer />
</Base>
