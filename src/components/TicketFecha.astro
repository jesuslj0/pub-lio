---
import { HORA_APERTURA, piezasFecha, rangoCorto, type Evento } from "../lib/eventos";

// Fecha y hora del evento en formato "entrada": matriz con el día a la
// izquierda, línea troquelada y los datos a la derecha.
interface Props {
  evento: Evento;
}
const { evento } = Astro.props;
const inicio = evento.fechaInicio ? piezasFecha(evento.fechaInicio) : null;
const varios = !!evento.fechaFin && evento.fechaFin !== evento.fechaInicio;
const fin = varios && evento.fechaFin ? piezasFecha(evento.fechaFin) : null;
---

<div class="ticket relative flex w-full max-w-md overflow-hidden border border-accent/40 bg-surface text-text">
  <div class="flex w-28 shrink-0 flex-col items-center justify-center gap-1 bg-accent/10 px-3 py-5 text-center">
    {
      inicio ? (
        <>
          <span class="font-mono text-[0.62rem] tracking-[0.2em] text-accent">{inicio.diaSemana}</span>
          <span class="font-display text-5xl leading-none">{inicio.dia}</span>
          <span class="font-mono text-[0.62rem] tracking-[0.2em] text-muted">
            {inicio.mes} {inicio.anio}
          </span>
        </>
      ) : (
        <span class="font-mono text-[0.62rem] uppercase tracking-[0.15em] text-muted">Fecha por confirmar</span>
      )
    }
  </div>

  <div class="ticket-troquel" aria-hidden="true"></div>

  <dl class="flex flex-1 flex-col justify-center gap-2.5 px-5 py-4">
    <div>
      <dt class="font-mono text-[0.55rem] uppercase tracking-[0.22em] text-muted">Cuándo</dt>
      <dd class="text-sm font-medium first-letter:uppercase">
        {inicio ? (fin ? `${rangoCorto(evento, true)}` : inicio.larga) : "Por confirmar"}
      </dd>
    </div>
    <div>
      <dt class="font-mono text-[0.55rem] uppercase tracking-[0.22em] text-muted">Hora</dt>
      <dd class="text-sm font-medium">{HORA_APERTURA ? `Desde las ${HORA_APERTURA}` : "Por la noche"}</dd>
    </div>
    <div>
      <dt class="font-mono text-[0.55rem] uppercase tracking-[0.22em] text-muted">Dónde</dt>
      <dd class="text-sm font-medium">Lío Music Pub · Plaza Mayor, 6 · El Bonillo</dd>
    </div>
  </dl>
</div>

<style>
  /* Muescas laterales y línea troquelada de la "entrada" */
  .ticket {
    --muesca: 9px;
    -webkit-mask:
      radial-gradient(circle var(--muesca) at 7rem 0, #0000 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--muesca) at 7rem 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
    mask:
      radial-gradient(circle var(--muesca) at 7rem 0, #0000 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--muesca) at 7rem 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
  }
  .ticket-troquel {
    width: 0;
    margin: 12px 0;
    border-left: 2px dashed color-mix(in srgb, var(--accent) 40%, transparent);
  }
</style>
