---
import { ArrowRight, Play } from "@lucide/astro";
import CuentaAtras from "./CuentaAtras.tsx";
import {
  HORA_APERTURA,
  finCuentaAtras,
  imagenCloudinary,
  inicioCuentaAtras,
  piezasFecha,
  rangoCorto,
  tienePagina,
  type Evento,
} from "../lib/eventos";

// Tarjeta de un evento próximo en /eventos: cartel, fecha tipo entrada,
// cuenta atrás y enlace a su ficha.
interface Props {
  evento: Evento;
  ahora: number;
}
const { evento, ahora } = Astro.props;
const enlace = tienePagina(evento) ? evento.ruta : null;
const img = evento.imagenFija ? imagenCloudinary(evento.imagenFija, 600) : null;
const inicio = evento.fechaInicio ? piezasFecha(evento.fechaInicio) : null;
const tInicio = inicioCuentaAtras(evento);
const tFin = finCuentaAtras(evento);
const Etiqueta = enlace ? "a" : "div";
---

<article class="evento-card group relative grid grid-cols-[110px_1fr] gap-5 border border-border bg-bg2 p-4 transition-colors hover:border-accent/50 sm:grid-cols-[170px_1fr] sm:gap-7 sm:p-5">
  <Etiqueta
    href={enlace ?? undefined}
    class="relative block aspect-[9/16] overflow-hidden bg-surface"
    tabindex={enlace ? -1 : undefined}
    aria-hidden={enlace ? "true" : undefined}
  >
    {
      img ? (
        <img
          src={img}
          alt={`Cartel de ${evento.titulo}`}
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span class="flex size-full items-center justify-center font-display text-2xl text-accent/20">LÍO</span>
      )
    }
    {
      evento.esVideo && (
        <span class="absolute right-2 bottom-2 inline-flex items-center gap-1 bg-bg/80 px-2 py-1 font-mono text-[0.55rem] uppercase tracking-[0.15em] text-accent">
          <Play size={10} stroke-width={2.5} /> Vídeo
        </span>
      )
    }
  </Etiqueta>

  <div class="flex min-w-0 flex-col justify-center gap-3">
    <p class="font-mono text-[0.62rem] uppercase tracking-[0.2em] text-accent">
      {inicio ? `${inicio.diaSemana} · ${rangoCorto(evento)}` : "Fecha por confirmar"}
    </p>
    <h3 class="font-display text-[clamp(1.6rem,4vw,2.6rem)] leading-[0.95] tracking-[0.01em] text-text">
      {
        enlace ? (
          <a href={enlace} class="after:absolute after:inset-0 focus-visible:outline-none">
            {evento.titulo}
          </a>
        ) : (
          evento.titulo
        )
      }
    </h3>
    {evento.subtitulo && <p class="line-clamp-2 text-sm font-light text-muted">{evento.subtitulo}</p>}
    {
      tInicio && tFin && (
        <div class="relative z-[1]">
          <CuentaAtras client:load inicio={tInicio} fin={tFin} conHora={!!HORA_APERTURA} ahoraServidor={ahora} compacta />
        </div>
      )
    }
    {
      enlace && (
        <span class="inline-flex items-center gap-1.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-text/70 transition-colors group-hover:text-accent">
          Ver evento <ArrowRight size={13} stroke-width={2} />
        </span>
      )
    }
  </div>
</article>

<style>
  /* El foco del enlace "estirado" se dibuja en toda la tarjeta */
  .evento-card:has(h3 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
